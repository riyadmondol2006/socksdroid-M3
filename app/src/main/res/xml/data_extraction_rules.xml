<?xml version="1.0" encoding="utf-8"?>
<!-- Profiles (including credentials) are not uploaded to cloud backup; device-to-device transfer keeps them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="profile.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
